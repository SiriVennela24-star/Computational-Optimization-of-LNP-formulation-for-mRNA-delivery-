# Quantum-XAI Platform Environment Configuration
NODE_ENV=development

# Optional External Quantum Cloud Provider (e.g. IBM Quantum Experience)
# Default is client-side / serverless simulated QAOA and classical annealing
IBM_QUANTUM_API_TOKEN=
IBM_QUANTUM_HUB=ibm-q
IBM_QUANTUM_GROUP=open
IBM_QUANTUM_PROJECT=main

# Data Ingestion Configuration
LNP_ATLAS_DATASET_URL=https://doi.org/10.5281/zenodo.17243733
DATA_VERSION=202509_v1

# Security & Limits
MAX_UPLOAD_SIZE_MB=50
ENABLE_RESEARCH_DIAGNOSTICS=true
